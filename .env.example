# Copiá este archivo a .env (local) o cargá estas variables en Vercel → Settings → Environment Variables.

# Base de datos Postgres (Neon, Supabase o Vercel Postgres). Sin esto, en local se usa una base embebida.
DATABASE_URL=

# Clave para firmar las sesiones: al menos 32 caracteres al azar (por ejemplo: openssl rand -base64 48).
SESSION_SECRET=

# URL pública del sitio, sin barra final. Ej: https://cuotalab.com.ar
URL_BASE=

# Mercado Pago: credenciales de producción de tu aplicación (Tus integraciones → Credenciales).
MP_ACCESS_TOKEN=
# Clave secreta de los webhooks (Tus integraciones → Webhooks). URL del webhook: {URL_BASE}/api/webhooks/mercadopago
MP_WEBHOOK_SECRET=

# Fuentes de datos. football-data.co.uk se usa siempre (gratis, sin clave).
# API-Football es opcional: suma la Liga Profesional, "ambos marcan" y cuotas diarias.
API_FOOTBALL_KEY=
# DESACTIVAR_FOOTBALL_DATA=1   # para no usar la fuente gratuita
# FUENTE_SIMULADA=1            # solo desarrollo: datos inventados

# Protege la tarea programada /api/cron/actualizar. Vercel la manda sola si existe.
CRON_SECRET=

# Correos de recuperación de contraseña (https://resend.com).
RESEND_API_KEY=
CORREO_REMITENTE=Cuotalab <no-responder@tudominio.com>
